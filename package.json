{
  "name": "hypertrophy-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "catalog:build": "node scripts/build-exercise-catalog.mjs",
    "catalog:check": "node scripts/validate-exercise-catalog.mjs",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check": "pnpm catalog:check && pnpm test && pnpm typecheck && pnpm build"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@supabase/supabase-js": "2.112.2",
    "dexie": "^4.4.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "27.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "4.0.8"
  }
}
